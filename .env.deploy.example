WEB_PORT=8080
PUBLIC_ORIGIN=https://wiki.example.com
LLM_WIKI_API_KEY=replace-with-a-long-random-token
WIKI_ROOT_PATH=/srv/wiki
WIKI_ROOT_PATH_INTERNAL=/data/wiki
IMAGE_ASSETS_ROOT_PATH_INTERNAL=/data/image-assets
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 多租户模式（设为 true 开启登录/部门功能）
VITE_MULTI_TENANT=true

# PostgreSQL 密码（必须修改，不要使用默认值）
POSTGRES_PASSWORD=replace-with-strong-password

# JWT 签名密钥（必须修改，至少 32 个字符）
JWT_SECRET=replace-with-minimum-32-character-secret-key!!

# 初始超级管理员账号（首次部署时自动创建，已有超管后此配置不再生效）
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-strong-password
INITIAL_ADMIN_NAME=Admin
