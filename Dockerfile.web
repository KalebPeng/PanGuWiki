FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
ARG VITE_DOTNET_URL=
ENV VITE_DOTNET_URL=$VITE_DOTNET_URL
ARG VITE_WIKI_PARENT_DIR=/data/wiki
ENV VITE_WIKI_PARENT_DIR=$VITE_WIKI_PARENT_DIR
RUN npm run build

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
